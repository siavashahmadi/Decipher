# Copy to .env and fill in values. Vite exposes only VITE_*-prefixed vars
# to the client bundle.

# Supabase project (required)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend API base URL (optional). Defaults to http://localhost:5000/api/v1
# when unset. Override in deployed environments to your production backend
# (e.g. https://api.example.com/api/v1).
VITE_API_URL=http://localhost:5000/api/v1
