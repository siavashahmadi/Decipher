# Build outputs and caches that should never be in the build context.
.git
.github
.claude
.vite
.pytest_cache
.DS_Store
*.pyc
**/__pycache__

# Frontend
frontend/node_modules
frontend/build
frontend/.vite
frontend/coverage

# Backend
backend/sia-venv
backend/venv
backend/.env
backend/.pytest_cache
backend/tests
backend/__pycache__

# Docs and meta — not needed inside the image
docs
TODO_manual_edits.md
README.md
CLAUDE.md

# Env files. Backend secrets stay out of the image (compose loads .env at
# runtime via env_file). frontend/.env is the exception: Vite reads it at
# BUILD time and inlines values into the bundle, so it must be in the build
# context. The anon key is the only Supabase value that ships there and is
# already public in the bundle, so this is safe.
.env
**/.env
!frontend/.env
*.env.local
